#!/bin/sh
CONFIG_LIBS="-L/mingw64/lib -lgdal"
CONFIG_DEP_LIBS="-larchive -liconv -lcharset -lcryptopp -lssl -lcrypto -lcrypt32 -llzma -ldeflate -llz4 -larmadillo -lOpenCL -lqhull_r -lSFCGAL -lgeotiff -ltiff -lheif -lLerc -laec -ljpeg -lpoppler -lpodofo -lpng -lgif -lnetcdf -lhdf5_hl -lzstd -lbz2 -lblosc -lcfitsio -lhdf5 -lwebp -lhdf -lmfhdf -lopenjp2 -lOpenEXR -lOpenEXRUtil -lImath -lIex -ljxl -ljxl_threads -lkmlbase -lkmldom -lkmlengine -lminizip -luriparser -lz -lpcre2-8 -lspatialite -lsqlite3 -lxerces-c -lmysqlclient -lpq -lodbc32 -lodbccp32 -lfreexl -larrow_dataset -lparquet -larrow_acero -larrow -lws2_32 -lexpat -lm -lxml2 -lgeos_c -lcurl -lpsapi -lproj -ljson-c -lstdc++ -lgcc_s"
CONFIG_PREFIX="/mingw64"
CONFIG_CFLAGS="-I/mingw64/include"
CONFIG_DATA="/mingw64/share/gdal"
CONFIG_VERSION="3.9.0"
CONFIG_GNM_ENABLED=yes
CONFIG_FORMATS="JPEG raw GTIFF MEM vrt Derived HFA SDTS NITF GXF AAIGrid CEOS SAR_CEOS XPM DTED JDEM Envisat ELAS FIT L1B RS2 ILWIS RMF Leveller SGI SRTMHGT IDRISI GSG ERS PALSARJaxa DIMAP GFF COSAR PDS ADRG COASP TSX Terragen BLX MSGN TIL R northwood SAGA XYZ HEIF ESRIC HF2 KMLSUPEROVERLAY CTG ZMap NGSGEOID IRIS MAP CALS SAFE SENTINEL2 PRF MRF WMTS GRIB BMP TGA STACTA BSB AIGrid USGSDEM AirSAR OZI PCIDSK SIGDEM RIK STACIT PDF PNG GIF WCS HTTP netCDF Zarr DAAS EEDA FITS HDF5 PLMOSAIC WMS OGCAPI WEBP HDF4 Rasterlite MBTiles PostGISRaster JP2OpenJPEG EXR PCRaster JPEGXL MEM geojson TAB Shape KML VRT AVC GML CSV DGN GMT NTF S57 Tiger Geoconcept GeoRSS DXF PGDump GPSBabel EDIGEO SXF OpenFileGDB WAsP Selafin JML VDV FlatGeobuf MapML JSONFG MiraMon SDTS GPX GMLAS SVG CSW LIBKML NAS PLSCENES WFS NGW Elastic Idrisi PDS SQLite GeoPackage OSM VFK MVT PMTiles AmigoCloud Carto ILI MySQL PG MSSQLSpatial ODBC PGeo XLSX XLS Parquet Arrow GTFS ODS LVBAG"
CONFIG_PLUGINDIR="/mingw64/lib/gdalplugins"
usage()

{
	cat <<EOF
Usage: gdal-config [OPTIONS]
Options:
	[--prefix[=DIR]]
	[--libs]
	[--dep-libs]
	[--cflags]
	[--datadir]
	[--version]
	[--ogr-enabled]
	[--gnm-enabled]
	[--formats]
	[--plugindir]
EOF
	exit $1
}

if test $# -eq 0; then
	usage 1 1>&2
fi

case $1 in
  --libs)
    echo $CONFIG_LIBS
    ;;

  --dep-libs)
    echo $CONFIG_DEP_LIBS
    ;;

  --cflags)
    echo $CONFIG_CFLAGS
    ;;

  --datadir)
    echo $CONFIG_DATA
    ;;

  --prefix)
    echo $CONFIG_PREFIX
    ;;

  --version)
    echo $CONFIG_VERSION
    ;;

  --ogr-enabled)
    echo yes
    ;;

  --gnm-enabled)
    echo $CONFIG_GNM_ENABLED
    ;;

  --formats)
    echo $CONFIG_FORMATS
    ;;

  --plugindir)
    echo $CONFIG_PLUGINDIR
    ;;

  *)
    usage 1 1>&2
    ;;

esac

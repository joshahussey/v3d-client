{
	https_port {$CSLT_3D_HTTPS_PORT}
}

{$DOMAIN_NAME} {$DOMAIN_NAME}:{$CSLT_3D_HTTPS_PORT} {
        @options {
        method OPTIONS
    }
	log {
		format console
		output file {$ROOT_DIR_3D}/logs/cslt3d_https.log
	}

	tls {$CERTS_DIR}/{$TLS_CERT_LOC} {$CERTS_DIR}/{$TLS_KEY_LOC}

	file_server {
		root /srv/
	}

	route /map* {
		handle {
                header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Credentials true
        Access-Control-Allow-Methods *
        Access-Control-Allow-Headers *
        defer
    }
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT} {
                header_down -Access-Control-Allow-Origin
                }
                respond @options 204
		}
	}
	route /add* {
		handle {
                header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Credentials true
        Access-Control-Allow-Methods *
        Access-Control-Allow-Headers *
        defer
    }
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT} {
                header_down -Access-Control-Allow-Origin
                }
                respond @options 204
		}
	}

	route /shape* {
		handle {
                header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Credentials true
        Access-Control-Allow-Methods *
        Access-Control-Allow-Headers *
        defer
    }
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT} {
                header_down -Access-Control-Allow-Origin
                }
                respond @options 204
		}
	}

	route /kml* {
		handle {
                header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Credentials true
        Access-Control-Allow-Methods *
        Access-Control-Allow-Headers *
        defer
    }
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT} {
                header_down -Access-Control-Allow-Origin
                }
                respond @options 204
		}
	}
}

{
	debug
	https_port {$CSLT_3D_HTTPS_PORT}
}

{$DOMAIN_NAME} {$DOMAIN_NAME}:{$CSLT_3D_HTTPS_PORT} {
	log {
		format console
		output file {$ROOT_DIR_3D}/logs/cslt3d_https.log
	}

	tls /certs/{$TLS_CERT_LOC} /certs/{$TLS_KEY_LOC}

	file_server {
		root /srv/
	}

	route /debug/* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}

	route /map* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}

	route /add* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}

	route /shape* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}

	route /gpkg* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}

	route /tilegpkg* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}

	route /kml* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}

	route /ogcfeatures* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}

	route /ogcfeatures/* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}

	route /views* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}

	route /view/* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}

	route /view* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}

	route /dataprovider* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}

	route /aoi* {
		handle {
			reverse_proxy {$DOMAIN_NAME}:{$BACKEND_PORT}
		}
	}
}

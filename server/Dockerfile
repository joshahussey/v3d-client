# syntax=docker/dockerfile:1

FROM caddy:2.7.6-alpine
ARG BACKEND_PORT_ARG=8080
ARG DOMAIN_NAME_ARG=localhost
ARG ROOT_DIR_3D_ARG=.
ARG HTTP_PORT_ARG=2015
ARG HTTPS_PORT_ARG=2016
ARG ADMIN_PORT_ARG=2019
ARG CADDYFILE=caddyfile-dev
WORKDIR /cslt
ENV BACKEND_PORT $BACKEND_PORT_ARG
ENV DOMAIN_NAME $DOMAIN_NAME_ARG
ENV ROOT_DIR_3D $ROOT_DIR_3D_ARG
ENV CSLT_3D_HTTP_PORT=$HTTP_PORT_ARG
ENV CSLT_3D_HTTPS_PORT=$HTTPS_PORT_ARG
ENV ADMIN_PORT=$ADMIN_PORT_ARG
COPY $CADDYFILE /etc/caddy/Caddyfile

{
    "name": "Standalone 3D Client",
    "version": "0.1.0",
    "description": "3D client",
    "main": "3dMap.js",
    "scripts": {
        "build-client": "export DOMAIN_NAME=localhost && export $(cat config/env | xargs) && webpack --config ./config/webpack.master.config.js",
        "build-client-release": "export $(cat config/env | xargs) && webpack --config ./config/webpack.master.config.js",
        "build-backend": "export $(cat config/env | xargs) && go build -C ./backend -v -x",
        "full-build": "export DOMAIN_NAME=localhost && export $(cat config/env | xargs) && webpack --config ./config/webpack.master.config.js && go build -C ./backend -v -x",
        "full-build-release": "export $(cat config/env | xargs) && webpack --config ./config/webpack.master.config.js && go build -C ./backend -v -x",
        "lint": "eslint 'src/**/*.{ts,tsx,js}' 'src/*.{ts,tsx,js}'",
        "fix": "eslint 'src/**/*.{ts,tsx,js}' 'src/*.{ts,tsx,js}' --fix",
        "dev": "export ROOT_DIR_3D=. && export DOMAIN_NAME=localhost && export $(cat config/env | xargs) && ./backend/run.sh && ./server/run.sh",
        "app": "export $(cat config/env | xargs) && ./backend/run.sh && ./server/run.sh"
    },
    "keywords": [
        "3d",
        "map",
        "cesium"
    ],
    "author": "Josh Hussey",
    "license": "ISC",
    "devDependencies": {
        "@babel/core": "^7.22.5",
        "@babel/plugin-transform-named-capturing-groups-regex": "^7.22.5",
        "@babel/plugin-transform-unicode-regex": "^7.22.5",
        "@babel/preset-env": "^7.22.5",
        "@babel/preset-typescript": "^7.22.5",
        "@thisbeyond/solid-select": "^0.14.0",
        "@types/geojson": "^7946.0.10",
        "@types/jest": "^29.5.5",
        "@types/knockout": "^3.4.72",
        "@types/knockout.es5": "^0.0.35",
        "@typescript-eslint/eslint-plugin": "^7.0.2",
        "assert": "^2.0.0",
        "babel-loader": "^9.1.2",
        "babel-plugin-transform-regexp-constructors": "^0.4.3",
        "babel-preset-minify": "^0.5.2",
        "babel-preset-solid": "^1.7.4",
        "browserify-zlib": "^0.2.0",
        "buffer": "^6.0.3",
        "cesium": "^1.105.1",
        "cesium-navigation-es6": "^3.0.8",
        "console-browserify": "^1.2.0",
        "constants-browserify": "^1.0.0",
        "copy-webpack-plugin": "^11.0.0",
        "core-js": "^3.32.0",
        "crypto-browserify": "^3.12.0",
        "css-loader": "^6.7.3",
        "domain-browser": "^4.22.0",
        "eslint-plugin-solid": "^0.13.0",
        "events": "^3.3.0",
        "geojson": "^0.5.0",
        "has": "^1.0.3",
        "html-webpack-plugin": "^5.5.3",
        "https-browserify": "^1.0.0",
        "knockout": "^3.5.1",
        "knockout-es5": "^0.4.5",
        "os-browserify": "^0.3.0",
        "path-browserify": "^1.0.1",
        "process": "^0.11.10",
        "protobufjs": "^7.2.2",
        "punycode": "^2.3.0",
        "purify": "^3.4.0",
        "querystring-es3": "^0.2.1",
        "sass": "^1.66.1",
        "sass-loader": "^13.3.2",
        "satellite.js": "^5.0.0",
        "solid-js": "^1.7.6",
        "source-map-loader": "^4.0.1",
        "stream-browserify": "^3.0.0",
        "stream-http": "^3.2.0",
        "string_decoder": "^1.3.0",
        "style-loader": "^3.3.2",
        "terser": "^5.19.2",
        "terser-webpack-plugin": "^5.3.9",
        "timers-browserify": "^2.0.12",
        "ts-jest": "^29.1.1",
        "ts-loader": "^9.4.2",
        "tty-browserify": "^0.0.1",
        "typescript": "^5.0.2",
        "uglify-js": "^3.17.4",
        "url": "^0.11.0",
        "url-loader": "^4.1.1",
        "util": "^0.12.5",
        "vm-browserify": "^1.1.2",
        "webpack": "^5.76.3",
        "webpack-cli": "^5.0.1",
        "webpack-merge": "^5.8.0"
    },
    "dependencies": {
        "@solid-primitives/websocket": "^1.2.1",
        "jest": "^29.7.0",
        "moment": "^2.29.4"
    },
    "prettier": {
        "printWidth": 120,
        "tabWidth": 4,
        "useTabs": false,
        "semi": true,
        "singleQuote": false,
        "trailingComma": "none",
        "bracketSpacing": true,
        "jsxBracketSameLine": false,
        "arrowParens": "avoid",
        "proseWrap": "preserve",
        "htmlWhitespaceSensitivity": "css",
        "endOfLine": "lf",
        "overrides": [
            {
                "files": "*.ts",
                "options": {
                    "parser": "typescript"
                }
            },
            {
                "files": "*.tsx",
                "options": {
                    "parser": "typescript"
                }
            }
        ]
    }
}

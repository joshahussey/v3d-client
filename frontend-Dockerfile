# syntax=docker/dockerfile:1

FROM node:20-alpine

WORKDIR /cslt

RUN [ "mkdir", "-p", "config", "src", "static" ]

COPY tsconfig.json /cslt/tsconfig.json
COPY package-lock.json /cslt/package-lock.json
COPY package.json /cslt/package.json
COPY config/ /cslt/config/
COPY src/ /cslt/src/
COPY static/ /cslt/static/

RUN [ "npm", "install" ]
RUN [ "npm", "run", "build-client" ]
RUN [ "rm", "-rf", "config" ]
RUN [ "rm", "-rf", "node_modules" ]
RUN [ "rm", "-rf", "package.json" ]
RUN [ "rm", "-rf", "package-lock.json" ]
RUN [ "rm", "-rf", "src" ]
RUN [ "rm", "-rf", "static" ]
RUN [ "rm", "-rf", "tsconfig.json" ]
CMD [ "tail", "-F", "/dev/null" ]

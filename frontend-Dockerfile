# syntax=docker/dockerfile:1

FROM node:20-alpine

ARG DOMAIN_NAME_ARG=localhost
ARG ROOT_DIR_ARG=.
ARG HTTP_PORT_ARG=2015
ARG HTTPS_PORT_ARG=2016
ARG ADMIN_PORT_ARG=2019

WORKDIR /cslt

RUN [ "mkdir", "-p", "config", "src", "static" ]

COPY tsconfig.json /cslt/tsconfig.json
COPY package-lock.json /cslt/package-lock.json
COPY package.json /cslt/package.json
COPY config/ /cslt/config/
COPY src/ /cslt/src/
COPY static/ /cslt/static/

ENV DOMAIN_NAME $DOMAIN_NAME_ARG
ENV ROOT_DIR $ROOT_DIR_ARG
ENV CSLT_3D_HTTPS_PORT $HTTPS_PORT_ARG
ENV CSLT_3D_HTTP_PORT $HTTP_PORT_ARG

RUN [ "npm", "install" ]
RUN [ "npm", "run", "docker-frontend" ]

RUN [ "rm", "-rf", "config" ]
RUN [ "rm", "-rf", "node_modules" ]
RUN [ "rm", "-rf", "package.json" ]
RUN [ "rm", "-rf", "package-lock.json" ]
RUN [ "rm", "-rf", "src" ]
RUN [ "rm", "-rf", "static" ]
RUN [ "rm", "-rf", "tsconfig.json" ]
CMD [ "tail", "-F", "/dev/null" ]

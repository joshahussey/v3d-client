#!/usr/bin/env murex

docker ps -q --filter "ancestor=standalone3d-frontend" -> frontendId
docker ps -q --filter "ancestor=standalone3d-backend" -> backendId
docker ps -q --filter "ancestor=standalone3d-server" -> serverId
docker rm -vf $frontendId $backendId $serverId
rm -rf ./logs/*
docker compose down --rmi all --remove-orphans
docker compose up --force-recreate -d
